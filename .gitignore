# Python
__pycache__/
*.py[cod]
.venv/
.venv*/
venv/

# Cache staging / scratch (never commit partial downloads)
*.part
.tmp_*

# The Julia conformance environment: EarthSciIO + its weakdeps in ONE resolution,
# built by conformance/dumpers/julia_env.jl. A build product like
# julia/Manifest.toml — regenerated from Project.toml, never committed.
/conformance/.julia-env/

# Local cache root (real $EARTHSCIDATADIR is on /scratch.local, never committed;
# the conformance corpus under conformance/corpus/cache/ is committed on purpose)
/earthsci-cache/

# Editor / OS
.DS_Store
*.swp
*.egg-info/

# Docs build products (EarthSciML/earthsci.dev tooling): generated pages, extracted
# docstrings, cargo targets, and the examples' resolved Julia environment.
/build/
/docs/content/generated/
/docs/api/examples/julia/Manifest.toml
/docs/api/examples/rust/target/
